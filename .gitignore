# ── Specific large model files (> 50 MB) ─────────────────────────────────────
# All other model files (< 50 MB) are tracked in version control.

# TabPFN models are very large and stored separately
Models/tabpfn_models/
Models/tabpfn_models/**

# Two LSTM optuna models that exceed 50 MB
Models/lstm_models/lstm_optuna_Embed_Feat_Var_inhibitor.pt
Models/lstm_models/lstm_optuna_Only_PC_Feat_Var_inhibitor.pt

# ── Large binary data files ───────────────────────────────────────────────────
# Training/test pickle datasets (binary, large, regenerated by preprocessing)
Data/*.pkl
Data/**/*.pkl

# Compressed feature matrices (regenerated by preprocessing scripts)
Data/*.csv.gz
Data/**/*.csv.gz

# R binary data files
Data/*.RData
Data/*.Rdata
Data/**/*.RData
Data/**/*.Rdata

# NFS temporary files (HPC artefacts, auto-removed)
.nfs*
**/.nfs*

# ── Python artefacts ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.ipynb_checkpoints/
*.egg-info/
dist/
build/
.eggs/

# ── R artefacts ──────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/

# ── SLURM / HPC logs ─────────────────────────────────────────────────────────
*.log
*.err
*.out
slurm-*.txt
logs/

# ── Jupyter ──────────────────────────────────────────────────────────────────
*.ipynb

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
scripts/.env

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
