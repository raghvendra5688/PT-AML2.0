# ── Large binary model files ────────────────────────────────────────────────
# All trained model artefacts are excluded from version control.
# Store them in a separate object-store (e.g. S3, HuggingFace Hub, DVC).
Models/**/*.pk
Models/**/*.pt
Models/**/*.pkl

# Keep directory stubs so the folder structure is visible in the repo
!Models/**/.gitkeep

# TabPFN models directory (very large — stored separately)
Models/tabpfn_models/
Models/tabpfn_models/**

# ── Large Results files ───────────────────────────────────────────────────────
# Per-sample prediction CSVs are large (~12 MB each) — regenerated by running scripts.
# Summary/metric CSVs and visualisation PDFs are kept.
Results/**/*_predictions.csv
Results/**/*_predictions.tsv
Results/**/*_test_predictions.csv

# NFS temporary files
.nfs*
**/.nfs*

# ── Large data files ─────────────────────────────────────────────────────────
# Pickle datasets (training/test sets, drug-patient feature matrices)
Data/*.pkl
Data/**/*.pkl

# Compressed feature matrices
Data/*.csv.gz
Data/**/*.csv.gz

# R binary data files
Data/*.RData
Data/*.Rdata
Data/**/*.RData
Data/**/*.Rdata

# ── Python artefacts ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.ipynb_checkpoints/
*.egg-info/
dist/
build/
.eggs/

# ── R artefacts ──────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/

# ── SLURM / HPC logs ─────────────────────────────────────────────────────────
*.log
*.err
*.out
slurm-*.txt
logs/

# ── Jupyter ──────────────────────────────────────────────────────────────────
*.ipynb

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
